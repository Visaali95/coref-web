generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String
  category   String
  supplier   String
  fobPrice   String
  leadTime   String?
  imageUrl   String?
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Enquiry {
  id          Int      @id @default(autoincrement())
  reference   String   @unique
  name        String
  company     String
  role        String
  items       String
  message     String
  attachments String?
  submittedAt DateTime @default(now())
  status      String   @default("New")
  email       String?
  phone       String?
}
